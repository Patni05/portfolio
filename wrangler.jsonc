{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bhupesh",
  "compatibility_date": "2026-09-01",

  /**
   * Static assets only — there is deliberately no `main`, so no Worker script
   * runs. Every route in this site is prerendered by `next build` with
   * `output: "export"`, so requests are served straight from Cloudflare's
   * asset storage: no cold starts, no CPU time, no request billing.
   */
  "assets": {
    "directory": "./out",

    /**
     * Matches Next's `trailingSlash: true`, which emits `/path/index.html`.
     * Without this the two disagree and `/about` would 404 or redirect-loop.
     */
    "html_handling": "force-trailing-slash",

    /** Next generates out/404.html for unmatched paths. */
    "not_found_handling": "404-page"
  },

  /**
   * Custom domain.
   *
   * Uncomment once bhupesh.dev is added as a zone in this Cloudflare account.
   * `custom_domain: true` makes Cloudflare create and manage the DNS record
   * and the certificate itself — no manual CNAME needed.
   *
   * The apex and www are listed separately because a custom domain route does
   * not cover subdomains implicitly.
   */
  // "routes": [
  //   { "pattern": "bhupesh.dev", "custom_domain": true },
  //   { "pattern": "www.bhupesh.dev", "custom_domain": true }
  // ],

  "observability": {
    "enabled": true
  }
}
